    "cwd": "$ZED_WORKTREE_ROOT",
    "stopOnEntry": false
  },
  {
    "adapter": "JavaScript",
    "label": "Debug Bun Tests",
    "type": "node",
    "request": "launch",
    "runtimeExecutable": "bun",
    "runtimeArgs": ["test", "--inspect-brk=9229"],
    "program": "$ZED_WORKTREE_ROOT/tests/cli.test.ts",
