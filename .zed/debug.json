    "runtimeArgs": ["--inspect-brk=9229"],
    "program": "$ZED_WORKTREE_ROOT/src/bin/apigee-templater.ts",
    "args": ["-i", "test.local.yaml", "-o", "test-2.local.yaml", "-f", "proxy"],
    "attachSimplePort": 9229,
    "cwd": "$ZED_WORKTREE_ROOT",
    "stopOnEntry": false
  },
  {
    "adapter": "JavaScript",
    "label": "Attach to Bun (Port 9229)",
