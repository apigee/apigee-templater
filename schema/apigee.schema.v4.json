{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/apigee/apigee-templater/main/schema/apigee.schema.v4.json",
  "title": "Apigee Templater YAML Schema",
  "description": "JSON Schema validating Apigee Templater YAML specifications (Templates, Features, and Proxies)",
  "oneOf": [
    { "$ref": "#/definitions/Feature" },
    { "$ref": "#/definitions/Proxy" },
    { "$ref": "#/definitions/Template" }
  ],
  "definitions": {
    "Step": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "condition": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Flow": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mode": { "type": "string", "enum": ["Request", "Response", ""] },
        "position": { "type": "string" },
        "condition": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/Step" }
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "FaultRule": {
      "allOf": [
        { "$ref": "#/definitions/Flow" },
        {
          "type": "object",
          "properties": {
            "alwaysEnforce": { "type": "boolean" }
          }
        }
      ]
    },
    "Route": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "condition": { "type": "string" },
        "target": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "basePath": { "type": "string" },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/Route" }
        }
      },
      "required": ["name", "basePath"],
      "additionalProperties": false
    },
    "ProxyEndpoint": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "basePath": { "type": "string" },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/Route" }
        },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "postClientFlow": { "$ref": "#/definitions/Flow" },
        "faultRules": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "defaultFaultRule": { "$ref": "#/definitions/FaultRule" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Target": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "auth": { "type": "string" },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "aud": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "ProxyTarget": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "auth": { "type": "string" },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "aud": { "type": "string" },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "faultRules": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "defaultFaultRule": { "$ref": "#/definitions/FaultRule" },
        "httpTargetConnection": { "type": ["object", "null"] },
        "localTargetConnection": { "type": ["object", "null"] }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Policy": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "object" }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "Resource": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["name", "type", "content"],
      "additionalProperties": false
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "maps": { "type": "object" },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "default": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Test": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "path": { "type": "string" },
        "method": { "type": "string" },
        "headers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "request": { "type": "string" },
        "queryParams": {
          "type": "array",
          "items": { "type": "string" }
        },
        "variables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assertions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Template": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "const": "template" },
        "priority": { "type": "number" },
        "description": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/Parameter" }
        },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/Endpoint" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/definitions/Target" }
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/definitions/Test" }
        }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "Feature": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string", "const": "feature" },
        "description": { "type": "string" },
        "documentation": { "type": "string" },
        "priority": { "type": "number" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/Parameter" }
        },
        "defaultEndpoint": { "$ref": "#/definitions/ProxyEndpoint" },
        "defaultTarget": { "$ref": "#/definitions/ProxyTarget" },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProxyEndpoint" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProxyTarget" }
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/definitions/Policy" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/definitions/Resource" }
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/definitions/Test" }
        }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "Proxy": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string", "const": "proxy" },
        "priority": { "type": "number" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "documentation": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/Parameter" }
        },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProxyEndpoint" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProxyTarget" }
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/definitions/Policy" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/definitions/Resource" }
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/definitions/Test" }
        }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    }
  }
}
