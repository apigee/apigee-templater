{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/apigee/apigee-templater/main/schema/gateway.schema.1.0.json",
  "title": "Apigee Templater YAML Schema",
  "description": "JSON Schema validating Apigee Templater YAML specifications (Templates, Features, and Proxies)",
  "oneOf": [
    { "$ref": "#/definitions/Feature" },
    { "$ref": "#/definitions/Proxy" },
    { "$ref": "#/definitions/Template" },
    { "$ref": "#/definitions/Product" },
    { "$ref": "#/definitions/User" }
  ],
  "definitions": {
    "Step": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "condition": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Flow": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mode": { "type": "string", "enum": ["Request", "Response", ""] },
        "condition": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/definitions/Step" }
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "FaultRule": {
      "allOf": [
        { "$ref": "#/definitions/Flow" },
        {
          "type": "object",
          "properties": {
            "alwaysEnforce": { "type": "boolean" }
          }
        }
      ]
    },
    "Route": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "condition": { "type": "string" },
        "target": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Endpoint": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "basePath": { "type": "string" },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/Route" }
        }
      },
      "required": ["name", "basePath"],
      "additionalProperties": false
    },
    "ProxyEndpoint": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "basePath": { "type": "string" },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/Route" }
        },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "postClientFlow": { "$ref": "#/definitions/Flow" },
        "faultRules": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "defaultFaultRule": { "$ref": "#/definitions/FaultRule" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Target": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "auth": { "type": "string" },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "aud": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "HTTPTargetConnection": {
      "type": "object",
      "properties": {
        "URL": { "type": "string" },
        "Properties": { "type": "object" },
        "SSLInfo": { "type": "object" },
        "LoadBalancer": { "type": "object" }
      },
      "additionalProperties": true
    },
    "ProxyTarget": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "auth": { "type": "string" },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "aud": { "type": "string" },
        "flows": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "faultRules": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "defaultFaultRule": { "$ref": "#/definitions/FaultRule" },
        "httpTargetConnection": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "HTTPTargetConnection": {
          "type": ["object", "null"],
          "additionalProperties": true
        },
        "localTargetConnection": { "type": ["object", "null"] },
        "LocalTargetConnection": { "type": ["object", "null"] }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "PolicyContent": {
      "type": "object",
      "properties": {
        "metadata": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "continueOnError": { "type": "string" },
            "enabled": { "type": "string" },
            "async": { "type": "string" },
            "timeLimit": { "type": "string" }
          },
          "additionalProperties": true
        },
        "_text": { "type": "string" },
        "DisplayName": { "type": ["string", "object"] },
        "Properties": { "type": "object" },
        "Source": { "type": ["string", "object"] },
        "IncludeURL": { "type": ["string", "object"] },
        "ResourceURL": { "type": ["string", "object"] },
        "AssignTo": { "type": ["object", "string"] },
        "IgnoreUnresolvedVariables": { "type": ["string", "boolean"] },
        "AssignVariable": { "type": ["array", "object"] },
        "Remove": { "type": "object" },
        "Add": { "type": "object" },
        "Set": { "type": "object" },
        "Copy": { "type": "object" },
        "Get": { "type": ["array", "object"] },
        "Put": { "type": ["array", "object"] },
        "Delete": { "type": ["array", "object"] },
        "Key": { "type": "object" },
        "Scope": { "type": ["string", "object"] },
        "ExclusiveCache": { "type": ["string", "boolean"] },
        "ExpiryTimeInSecs": { "type": ["string", "number", "object"] },
        "Capture": { "type": ["array", "object"] },
        "Collect": { "type": ["array", "object"] },
        "FaultRules": {
          "type": "array",
          "items": { "$ref": "#/definitions/Flow" }
        },
        "DefaultFaultRule": { "$ref": "#/definitions/FaultRule" }
      },
      "additionalProperties": true
    },
    "Policy": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "content": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/PolicyContent"
          }
        }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "Resource": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "content": { "type": "string" }
      },
      "required": ["name", "type", "content"],
      "additionalProperties": false
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "maps": { "type": "object" },
        "examples": {
          "type": "array",
          "items": { "type": "string" }
        },
        "default": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Test": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "path": { "type": "string" },
        "method": { "type": "string" },
        "headers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "request": { "type": "string" },
        "queryParams": {
          "type": "array",
          "items": { "type": "string" }
        },
        "variables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assertions": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Template": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "const": "template" },
        "gateway": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "priority": { "type": "number" },
        "description": { "type": "string" },
        "documentation": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/Parameter" }
        },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/Endpoint" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/definitions/Target" }
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/definitions/Test" }
        },
        "products": {
          "type": "array",
          "items": { "type": "string" }
        },
        "users": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "type", "gateway", "schemaVersion"],
      "additionalProperties": false
    },
    "Feature": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string", "const": "feature" },
        "gateway": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "description": { "type": "string" },
        "documentation": { "type": "string" },
        "priority": { "type": "number" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/Parameter" }
        },
        "defaultEndpoint": { "$ref": "#/definitions/ProxyEndpoint" },
        "defaultTarget": { "$ref": "#/definitions/ProxyTarget" },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProxyEndpoint" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProxyTarget" }
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/definitions/Policy" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/definitions/Resource" }
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/definitions/Test" }
        }
      },
      "required": ["type", "gateway", "schemaVersion"],
      "additionalProperties": false
    },
    "Proxy": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string", "const": "proxy" },
        "gateway": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "priority": { "type": "number" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "description": { "type": "string" },
        "documentation": { "type": "string" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/definitions/Parameter" }
        },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProxyEndpoint" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProxyTarget" }
        },
        "policies": {
          "type": "array",
          "items": { "$ref": "#/definitions/Policy" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/definitions/Resource" }
        },
        "tests": {
          "type": "array",
          "items": { "$ref": "#/definitions/Test" }
        }
      },
      "required": ["name", "type", "gateway", "schemaVersion"],
      "additionalProperties": false
    },
    "ProductAttribute": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["name", "value"],
      "additionalProperties": false
    },
    "ProductQuota": {
      "type": "object",
      "properties": {
        "limit": { "type": "string" },
        "interval": { "type": "string" },
        "timeUnit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ProductOperation": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "name": { "type": "string" },
        "methods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "additionalProperties": false
    },
    "ProductOperationConfig": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductOperation" }
        },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "required": ["operations"],
      "additionalProperties": false
    },
    "ProductLlmOperation": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "name": { "type": "string" },
        "methods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "model": { "type": "string" },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "additionalProperties": false
    },
    "ProductLlmOperationConfig": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductLlmOperation" }
        },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "required": ["operations"],
      "additionalProperties": false
    },
    "ProductPayloadOperation": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "protocol": { "type": "string" },
        "name": { "type": "string" },
        "operation": { "type": "string" },
        "methods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "additionalProperties": false
    },
    "ProductPayloadOperationConfig": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "protocol": { "type": "string" },
        "operations": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "$ref": "#/definitions/ProductPayloadOperation" }
            ]
          }
        },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "required": ["operations"],
      "additionalProperties": false
    },
    "ProductGraphqlOperation": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "operation": { "type": "string" },
        "operationTypes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "additionalProperties": false
    },
    "ProductGraphqlOperationConfig": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductGraphqlOperation" }
        },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "required": ["operations"],
      "additionalProperties": false
    },
    "ProductGrpcOperation": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "methods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "service": { "type": "string" },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "additionalProperties": false
    },
    "ProductGrpcOperationConfig": {
      "type": "object",
      "properties": {
        "apiSource": { "type": "string" },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductGrpcOperation" }
        },
        "quota": { "$ref": "#/definitions/ProductQuota" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        }
      },
      "required": ["operations"],
      "additionalProperties": false
    },
    "Product": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "const": "product" },
        "gateway": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "approvalType": { "type": "string" },
        "environments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proxies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "apiResources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "quota": { "type": "string" },
        "quotaInterval": { "type": "string" },
        "quotaTimeUnit": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/ProductAttribute" }
        },
        "operations": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/ProductOperation" },
              { "$ref": "#/definitions/ProductOperationConfig" }
            ]
          }
        },
        "llmOperations": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/ProductLlmOperation" },
              { "$ref": "#/definitions/ProductLlmOperationConfig" }
            ]
          }
        },
        "payloadOperations": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/ProductPayloadOperation" },
              { "$ref": "#/definitions/ProductPayloadOperationConfig" }
            ]
          }
        },
        "graphqlOperations": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/ProductGraphqlOperation" },
              { "$ref": "#/definitions/ProductGraphqlOperationConfig" }
            ]
          }
        },
        "grpcOperations": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/ProductGrpcOperation" },
              { "$ref": "#/definitions/ProductGrpcOperationConfig" }
            ]
          }
        }
      },
      "required": ["name", "type", "gateway", "schemaVersion"],
      "additionalProperties": false
    },
    "UserAttribute": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["name", "value"],
      "additionalProperties": false
    },
    "UserCredential": {
      "type": "object",
      "properties": {
        "consumerKey": { "type": "string" },
        "consumerSecret": { "type": "string" },
        "key": { "type": "string" },
        "secret": { "type": "string" },
        "status": { "type": "string" },
        "issuedAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "products": {
          "type": "array",
          "items": { "type": "string" }
        },
        "apiProducts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserAttribute" }
        }
      },
      "additionalProperties": false
    },
    "UserApp": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "callbackUrl": { "type": "string" },
        "status": { "type": "string" },
        "keyExpiresIn": { "type": "string" },
        "products": {
          "type": "array",
          "items": { "type": "string" }
        },
        "apiProducts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserAttribute" }
        },
        "credentials": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserCredential" }
        },
        "keys": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserCredential" }
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "User": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "displayName": { "type": "string" },
        "uid": { "type": "string" },
        "type": { "type": "string", "const": "user" },
        "gateway": { "type": "string" },
        "schemaVersion": { "type": "string" },
        "priority": { "type": "number" },
        "description": { "type": "string" },
        "documentation": { "type": "string" },
        "email": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string" },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserAttribute" }
        },
        "apps": {
          "type": "array",
          "items": { "$ref": "#/definitions/UserApp" }
        }
      },
      "required": ["name", "type", "gateway", "schemaVersion"],
      "additionalProperties": false
    }
  }
}
